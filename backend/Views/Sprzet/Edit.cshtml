@model backend.Models.Sprzet

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Sprzet @Html.DisplayFor(model => model.Id)</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        @using (Html.BeginForm("Edit", "Sprzet", FormMethod.Post))
        {
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })
            <p>Typ sprzętu: @Html.DropDownListFor(a => a.Typ, new SelectList(Enum.GetValues(typeof(Rodzaje))), new { @class = "form-control" })</p>
            <p>Marka sprzętu: @Html.DropDownListFor(a => a.Marka, new SelectList(Enum.GetValues(typeof(Marki))), new { @class = "form-control" }) </p>
            <p>Rozmiar sprzętu: @Html.TextBoxFor(a => a.Rozmiar, new { type = "number" }) </p>
            <p>Data zakupu: @Html.TextBoxFor(a => a.Data_zakupu, "{0:yyyy-MM-dd}",new { type = "date" }) </p>
            <p>Cena wypożyczenia: @Html.TextBoxFor(a => a.Koszt_wypozyczenia, new { type = "number" }) </p>
            <input type="submit" value="Edytuj Sprzęt" class="btn btn-secondary" />
            <input type="reset" value="Wyczyść Formularz" class="btn btn-secondary" />
        }
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
