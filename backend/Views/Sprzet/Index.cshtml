@model IEnumerable<backend.Models.Sprzet>

@{
    ViewData["Title"] = "Index";
}

<h1>Sprzęt</h1>

<p>
    @if (User.Identity.IsAuthenticated)
    {
        <a asp-action="Create">Create New</a>
    }
</p>
<p>
    <a asp-action="Index" asp-route-typ="Snowboard">Snowboard</a>
    <a asp-action="Index" asp-route-typ="Narty">Narty</a>
    <a asp-action="Index">Wszystko</a>
</p>
<p></p>
<table class="table">
    <thead>
        <tr>
            @if (User.Identity.IsAuthenticated)
            {
                <th>
                    @Html.DisplayNameFor(model => model.Id)
                </th>
            }
            <th>
                @Html.DisplayNameFor(model => model.Typ)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Marka)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rozmiar)
            </th>
            @if (User.Identity.IsAuthenticated)
            {
                <th>
                @Html.DisplayNameFor(model => model.Data_zakupu)
                </th>
            }
            <th>
                @Html.DisplayNameFor(model => model.Koszt_wypozyczenia)
            </th>
            @if (User.Identity.IsAuthenticated)
            {
                <th>
                @Html.DisplayNameFor(model => model.Wypozyczony)
            </th>
            }
            <th></th>
            @if (User.Identity.IsAuthenticated)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {

    @if (User.Identity.IsAuthenticated)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Typ)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Marka)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Rozmiar)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Data_zakupu)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Koszt_wypozyczenia)zł
            </td>
            <td>
                @if (item.Wypozyczony == 1)
                {
                    <p>TAK</p>
                }
                else
                {
                    <p>NIE</p>
                }
            </td>
            <td>
                @Html.ActionLink("Wypozycz", "Wypozycz", new { id=item.Id })
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.Id })
            </td>
        </tr>
    }
    else
    {
        @if (item.Wypozyczony == 0)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Typ)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Marka)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Rozmiar)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Koszt_wypozyczenia)zł
                </td>
                <td>
                    @Html.ActionLink("Wypozycz", "Wypozycz", new { id=item.Id })
                </td>
            </tr>
        }
    }
}
    </tbody>
</table>
