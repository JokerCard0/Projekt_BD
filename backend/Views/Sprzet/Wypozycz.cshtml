@model backend.Models.ViewModels.WypozyczViewModel;

@{
    ViewData["Title"] = "Wypozycz";
}

<h1>Sprzet</h1>

<h4>Wypożycz</h4>
<hr />
@using (Html.BeginForm("Wypozycz", "Sprzet", FormMethod.Post))
{
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    @* <p>Typ sprzętu: @Html.DropDownListFor(a => a.Typ, new SelectList(Enum.GetValues(typeof(Rodzaje))), new { @class = "form-control" })</p>
    <p>Marka sprzętu: @Html.DropDownListFor(a => a.Marka, new SelectList(Enum.GetValues(typeof(Marki))), new { @class = "form-control" }) </p>
    <p>Rozmiar sprzętu: @Html.TextBoxFor(a => a.Rozmiar, new { type = "number" }) </p>
    <p>Data zakupu: @Html.TextBoxFor(a => a.Data_zakupu, new { type = "date" }) </p>
    <p>Cena wypożyczenia: @Html.TextBoxFor(a => a.Koszt_wypozyczenia, new { type = "number" }) </p> *@
    @Html.HiddenFor(a => a.SprzetId)
    <p>Imie: @Html.TextBoxFor(a => a.Imie, new {Type = "string"})</p>
    <p>Nazwisko: @Html.TextBoxFor(a => a.Nazwisko, new { Type = "string" })</p>
    <p>Pesel: @Html.TextBoxFor(a => a.Pesel, new { Type = "string" })</p>

    <p>Kod pocztowy: @Html.TextBoxFor(a => a.Kod_pocztowy, new { Type = "string" })</p>
    <p>Miasto: @Html.TextBoxFor(a => a.Miasto, new { Type = "string" })</p>
    <p>Ulica: @Html.TextBoxFor(a => a.Ulica, new { Type = "string" })</p>
    <p>Numer budynku: @Html.TextBoxFor(a => a.Numer_budynku, new { Type = "string" })</p>
    <p>Numer mieszkania: @Html.TextBoxFor(a => a.Numer_mieszkania, new { Type = "string" })</p>
    <p>Data wypożyczenia: @Html.TextBoxFor(a => a.Data_wypoz, new { type = "date" , min = DateTime.Now.ToString("yyyy-MM-dd")}) </p>
    <p>Okres wypożyczenia: @Html.TextBoxFor(a => a.Okres_wypoz, new { type = "number" }) </p>
    <input type="submit" value="Wypożycz" class="btn btn-secondary" />
    <input type="reset" value="Wyczyść Formularz" class="btn btn-secondary" />
}

<div>
    <a asp-action="Index">Powrót do listy</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
